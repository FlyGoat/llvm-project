# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=aarch64 -run-pass=aarch64-prelegalizer-combiner -aarch64prelegalizercombiner-only-enable-rule=load_and_mask -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=LE
# RUN: llc -mtriple=aarch64_be -run-pass=aarch64-prelegalizer-combiner -aarch64prelegalizercombiner-only-enable-rule=load_and_mask -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=BE

# Use the access size in bytes even when the memory type has padding bits.
# Reducing a 24-bit access to 16 bits must reduce its alignment on big endian.
---
name: load24_mask255
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x0
    ; LE-LABEL: name: load24_mask255
    ; LE: liveins: $x0
    ; LE-NEXT: {{  $}}
    ; LE-NEXT: %p:_(p0) = COPY $x0
    ; LE-NEXT: %r:_(s32) = G_ZEXTLOAD %p(p0) :: (load (s8), align 4)
    ; LE-NEXT: $w0 = COPY %r(s32)
    ; LE-NEXT: RET_ReallyLR implicit $w0
    ;
    ; BE-LABEL: name: load24_mask255
    ; BE: liveins: $x0
    ; BE-NEXT: {{  $}}
    ; BE-NEXT: %p:_(p0) = COPY $x0
    ; BE-NEXT: [[C:%[0-9]+]]:_(s64) = G_CONSTANT i64 2
    ; BE-NEXT: [[PTR_ADD:%[0-9]+]]:_(p0) = nuw inbounds G_PTR_ADD %p, [[C]](s64)
    ; BE-NEXT: %r:_(s32) = G_ZEXTLOAD [[PTR_ADD]](p0) :: (load (s8) from unknown-address + 2, align 2)
    ; BE-NEXT: $w0 = COPY %r(s32)
    ; BE-NEXT: RET_ReallyLR implicit $w0
    %p:_(p0) = COPY $x0
    %m:_(s32) = G_CONSTANT i32 255
    %v:_(s32) = G_LOAD %p :: (load (s24), align 4)
    %r:_(s32) = G_AND %v, %m
    $w0 = COPY %r(s32)
    RET_ReallyLR implicit $w0
...
