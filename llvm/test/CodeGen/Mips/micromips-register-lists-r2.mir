# RUN: llc -mtriple=mipsel -mcpu=mips32r2 -mattr=+micromips \
# RUN:   -run-pass=none -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=MIR
# RUN: llc -mtriple=mipsel -mcpu=mips32r2 -mattr=+micromips \
# RUN:   -start-before=mips-delay-slot-filler -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=ASM

---
name: register_lists
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $a0
    ; MIR-LABEL: name: register_lists
    ; MIR: $s0_ra = LWM16_MM $sp, 60
    ; MIR-NEXT: SWM16_MM killed $s0_ra, $sp, 60
    ; ASM-LABEL: register_lists:
    ; ASM: lwm16 $16, $ra, 60($sp)
    ; ASM-NEXT: swm16 $16, $ra, 60($sp)
    $s0_ra = LWM16_MM $sp, 60
    SWM16_MM killed $s0_ra, $sp, 60

    ; MIR: $s0_s1_s2_s3_s4_s5_s6_s7_fp_ra = LWM32_MM $a0, 0
    ; MIR-NEXT: SWM32_MM killed $s0_s1_s2_s3_s4_s5_s6_s7_fp_ra, $a0, 0
    ; ASM: lwm32 $16, $17, $18, $19, $20, $21, $22, $23, $fp, $ra, 0($4)
    ; ASM-NEXT: swm32 $16, $17, $18, $19, $20, $21, $22, $23, $fp, $ra, 0($4)
    $s0_s1_s2_s3_s4_s5_s6_s7_fp_ra = LWM32_MM $a0, 0
    SWM32_MM killed $s0_s1_s2_s3_s4_s5_s6_s7_fp_ra, $a0, 0

    ; MIR: $s0_lwm = LWM32_MM $a0, 0
    ; MIR-NEXT: SWM32_MM killed $s0_lwm, $a0, 0
    ; ASM: lwm32 $16, 0($4)
    ; ASM-NEXT: swm32 $16, 0($4)
    $s0_lwm = LWM32_MM $a0, 0
    SWM32_MM killed $s0_lwm, $a0, 0

    ; MIR: $ra_lwm = LWM32_MM $a0, 0
    ; MIR-NEXT: SWM32_MM killed $ra_lwm, $a0, 0
    ; ASM: lwm32 $ra, 0($4)
    ; ASM-NEXT: swm32 $ra, 0($4)
    $ra_lwm = LWM32_MM $a0, 0
    SWM32_MM killed $ra_lwm, $a0, 0
    PseudoReturn undef $ra
...
