# Exercise the combines on legal MIR, including cases legalization exposes.
---
name: add_zero
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $a0
    ; CHECK-LABEL: name: add_zero
    ; CHECK: liveins: $a0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(s32) = COPY $a0
    ; CHECK-NEXT: $v0 = COPY %x(s32)
    ; CHECK-NEXT: RetRA implicit $v0
    %x:_(s32) = COPY $a0
    %c:_(s32) = G_CONSTANT i32 0
    %r:_(s32) = G_ADD %x, %c
    $v0 = COPY %r(s32)
    RetRA implicit $v0
...
