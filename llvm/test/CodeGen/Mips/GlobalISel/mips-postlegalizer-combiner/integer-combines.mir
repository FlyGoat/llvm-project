# Do not introduce an unsupported vector constant for MSA operations.
---
name: vector_sub_self
legalized: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $w0
    ; CHECK-LABEL: name: vector_sub_self
    ; CHECK: liveins: $w0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: %x:_(<4 x s32>) = COPY $w0
    ; CHECK-NEXT: %r:_(<4 x s32>) = G_SUB %x, %x
    ; CHECK-NEXT: $w0 = COPY %r(<4 x s32>)
    ; CHECK-NEXT: RetRA implicit $w0
    %x:_(<4 x s32>) = COPY $w0
    %r:_(<4 x s32>) = G_SUB %x, %x
    $w0 = COPY %r(<4 x s32>)
    RetRA implicit $w0
...
