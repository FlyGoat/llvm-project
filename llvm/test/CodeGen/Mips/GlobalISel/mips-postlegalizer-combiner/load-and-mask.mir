    ; BE-LABEL: name: word_to_byte
    ; BE: liveins: $a0
    ; BE-NEXT: {{  $}}
    ; BE-NEXT: %p:_(p0) = COPY $a0
    ; BE-NEXT: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 3
    ; BE-NEXT: [[PTR_ADD:%[0-9]+]]:_(p0) = nuw inbounds G_PTR_ADD %p, [[C]](s32)
    ; BE-NEXT: %r:_(s32) = G_ZEXTLOAD [[PTR_ADD]](p0) :: (load (s8) from unknown-address + 3)
    ; BE-NEXT: $v0 = COPY %r(s32)
    ; BE-NEXT: RetRA implicit $v0
    %p:_(p0) = COPY $a0
    %mask:_(s32) = G_CONSTANT i32 255
    %v:_(s32) = G_LOAD %p :: (load (s32))
    %r:_(s32) = G_AND %v, %mask
    $v0 = COPY %r(s32)
    RetRA implicit $v0
...
