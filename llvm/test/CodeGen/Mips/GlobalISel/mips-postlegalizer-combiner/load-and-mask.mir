    ; LE-NEXT: %p:_(p0) = COPY $a0
    ; LE-NEXT: %r:_(s32) = G_ZEXTLOAD %p(p0) :: (load (s8), align 4)
    ; LE-NEXT: $v0 = COPY %r(s32)
    ; LE-NEXT: RetRA implicit $v0
