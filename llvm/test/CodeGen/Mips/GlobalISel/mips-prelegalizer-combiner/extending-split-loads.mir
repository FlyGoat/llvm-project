# Keep the explicit extension for non-byte-sized loads: their padding bits
# cannot be assumed to be zero.
---
name: zextload20
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $a0
    ; CHECK-LABEL: name: zextload20
    ; CHECK: liveins: $a0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(p0) = COPY $a0
    ; CHECK-NEXT: [[LOAD:%[0-9]+]]:_(s20) = G_LOAD [[COPY]](p0) :: (load (s20), align 1)
    ; CHECK-NEXT: [[ZEXT:%[0-9]+]]:_(s32) = G_ZEXT [[LOAD]](s20)
    ; CHECK-NEXT: $v0 = COPY [[ZEXT]](s32)
    ; CHECK-NEXT: RetRA implicit $v0
    %0:_(p0) = COPY $a0
    %1:_(s20) = G_LOAD %0 :: (load (s20), align 1)
    %2:_(s32) = G_ZEXT %1
    $v0 = COPY %2
    RetRA implicit $v0
...
