# RUN: llc -mtriple=mipsel-linux-gnu -run-pass=mips-prelegalizer-combiner -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=mips-linux-gnu -run-pass=mips-prelegalizer-combiner -verify-machineinstrs %s -o - | FileCheck %s

# Preserve the extension when forming loads that will require splitting.
---
name: sextload16
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $a0
    ; CHECK-LABEL: name: sextload16
    ; CHECK: liveins: $a0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(p0) = COPY $a0
    ; CHECK-NEXT: [[SEXTLOAD:%[0-9]+]]:_(s32) = G_SEXTLOAD [[COPY]](p0) :: (volatile load (s16), align 1)
    ; CHECK-NEXT: $v0 = COPY [[SEXTLOAD]](s32)
    ; CHECK-NEXT: RetRA implicit $v0
    %0:_(p0) = COPY $a0
    %1:_(s16) = G_LOAD %0 :: (volatile load (s16), align 1)
    %2:_(s32) = G_SEXT %1
    $v0 = COPY %2
    RetRA implicit $v0
...
