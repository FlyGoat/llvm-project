# RUN: llc -mtriple=mipsel -mcpu=mips32r2 -mattr=+micromips \
# RUN:   -run-pass=micromips-reduce-size -verify-machineinstrs %s -o - | FileCheck %s

---
name: move_dead_nonconsecutive_pair
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $s0, $s1
    ; CHECK-LABEL: name: move_dead_nonconsecutive_pair
    ; CHECK: dead $a0_s5 = MOVEP_MM killed $s0, killed $s1
    dead $s5 = MOVE16_MM killed $s1
    dead $a0 = MOVE16_MM killed $s0
    PseudoReturn undef $ra
...
---
name: move_partially_dead_pair
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $v0, $v1
    ; CHECK-LABEL: name: move_partially_dead_pair
    ; CHECK: $a0_a1 = MOVEP_MM killed $v0, killed $v1
    ; CHECK-NEXT: PseudoReturn undef $ra, implicit $a1
    dead $a0 = MOVE16_MM killed $v0
    $a1 = MOVE16_MM killed $v1
    PseudoReturn undef $ra, implicit $a1
...
